# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-only; powers the AI tutor at /api/tutor)
ANTHROPIC_API_KEY=

# Site URL (used by Supabase magic-link redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Databricks (server-only; powers the embedded dashboard at /databricks).
# OAuth machine-to-machine credentials for a service principal. The
# server exchanges these for a short-lived access token on each request
# (and again via the SDK's refresh callback before expiry). Create the
# service principal in your Databricks workspace and grant it CAN_VIEW
# on the dashboard you're embedding.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
